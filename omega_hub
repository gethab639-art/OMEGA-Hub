-- OMEGA MINI HUB v1.0 — FTAP (Delta)
-- Свой хаб: один файл, без скачиваний, работает без VPN
local RS = game:GetService("ReplicatedStorage")
local PS = game:GetService("Players")
local RunS = game:GetService("RunService")
local LP = PS.LocalPlayer
char = LP.Character or LP.CharacterAdded:Wait()
LP.CharacterAdded:Connect(function(c) char = c end)
local SNO = RS:WaitForChild("GrabEvents"):WaitForChild("SetNetworkOwner")
local DestroyToy = RS:WaitForChild("MenuToys"):WaitForChild("DestroyToy")
local conns = {}
local function hrp() return char and char:FindFirstChild("HumanoidRootPart") end
local function nearest()
local best, bd = nil, math.huge
for _, p in ipairs(PS:GetPlayers()) do
if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and hrp() then
local d = (p.Character.HumanoidRootPart.Position - hrp().Position).Magnitude
if d < bd then best, bd = p, d end
end
end
return best
end
local function dropVoid(part)
if not part then return end
local h = workspace.FallenPartsDestroyHeight
SNO:FireServer(part, part.CFrame)
part.CFrame = CFrame.new(0, -50000, 0)
task.wait(0.1)
workspace.FallenPartsDestroyHeight = -45000
task.wait()
workspace.FallenPartsDestroyHeight = h
end
local gui = Instance.new("ScreenGui")
gui.Name = "OMEGA_MINI_HUB"
gui.ResetOnSpawn = false
pcall(function() gui.Parent = (typeof(gethui) == "function" and gethui()) or game:GetService("CoreGui") end)
local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(200, 290)
panel.Position = UDim2.fromOffset(10, 180)
panel.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
panel.Active = true
panel.Parent = gui
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 34)
title.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
title.TextColor3 = Color3.fromRGB(150, 110, 255)
title.Font = Enum.Font.Code
title.TextSize = 14
title.Text = "OMEGA MINI"
title.Parent = panel
local drag = false
title.InputBegan:Connect(function(i)
if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end
end)
title.InputEnded:Connect(function(i)
if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end
end)
RunS.RenderStepped:Connect(function()
if drag then
local m = LP:GetMouse()
panel.Position = UDim2.fromOffset(m.X - 100, m.Y - 17)
end
end)
local function mkbtn(txt, n)
local b = Instance.new("TextButton")
b.Size = UDim2.new(1, -12, 0, 38)
b.Position = UDim2.new(0, 6, 0, 40 + (n - 1) * 42)
b.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
b.TextColor3 = Color3.new(1, 1, 1)
b.Font = Enum.Font.Code
b.TextSize = 13
b.Text = txt
b.Parent = panel
return b
end
local function togglebtn(b, on)
b.BackgroundColor3 = on and Color3.fromRGB(90, 60, 200) or Color3.fromRGB(35, 35, 42)
end
local bAF = mkbtn("Anti Fling", 1)
local bVoid = mkbtn("Void Platform", 2)
local bFling = mkbtn("Флинг ближнего", 3)
local bKill = mkbtn("Сброс ближнего", 4)
local bToys = mkbtn("Убрать мои вещи", 5)
local bSpeed = mkbtn("Скорость 100", 6)
local bHide = mkbtn("Скрыть", 7)
bAF.MouseButton1Click:Connect(function()
bAF_on = not bAF_on
togglebtn(bAF, bAF_on)
if bAF_on then
conns.af = RunS.RenderStepped:Connect(function()
if char and char:FindFirstChild("Torso") then
char.Torso.CollisionGroupId = 5
char.Head.CollisionGroupId = 5
if char:FindFirstChild("HumanoidRootPart") then char.HumanoidRootPart.CollisionGroupId = 5 end
end
end)
elseif conns.af then
conns.af:Disconnect()
conns.af = nil
end
end)
bVoid.MouseButton1Click:Connect(function()
bVoid_on = not bVoid_on
togglebtn(bVoid, bVoid_on)
if bVoid_on then
local vp = Instance.new("Part")
vp.Name = "OMEGA_VoidPlatform"
vp.Shape = Enum.PartType.Ball
vp.Material = Enum.Material.Air
vp.CFrame = CFrame.new(0, -522.5, 0)
vp.Size = Vector3.new(50, 500, 500)
vp.Anchored = true
vp.Transparency = 0.25
vp.Color = Color3.new(0, 0, 0)
vp.Parent = workspace
else
local old = workspace:FindFirstChild("OMEGA_VoidPlatform")
if old then old:Destroy() end
end
end)
bFling.MouseButton1Click:Connect(function()
local t = nearest()
if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
local p = t.Character.HumanoidRootPart
SNO:FireServer(p, p.CFrame)
p.AssemblyAngularVelocity = Vector3.new(0, 1000000, 0)
p.AssemblyLinearVelocity = Vector3.new(0, 5000, 0)
end
end)
bKill.MouseButton1Click:Connect(function()
local t = nearest()
if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
dropVoid(t.Character.HumanoidRootPart)
end
end)
bToys.MouseButton1Click:Connect(function()
local folder = workspace:FindFirstChild(LP.Name .. "SpawnedInToys")
if folder then
for _, t in ipairs(folder:GetChildren()) do
DestroyToy:FireServer(t)
end
end
end)
bSpeed.MouseButton1Click:Connect(function()
bSpeed_on = not bSpeed_on
togglebtn(bSpeed, bSpeed_on)
if hum() then hum().WalkSpeed = bSpeed_on and 100 or 16 end
end)
bHide.MouseButton1Click:Connect(function()
panel.Visible = false
end)
local dot = Instance.new("TextButton")
dot.Size = UDim2.fromOffset(40, 40)
dot.Position = UDim2.fromOffset(10, 10)
dot.BackgroundColor3 = Color3.fromRGB(90, 60, 200)
dot.TextColor3 = Color3.new(1, 1, 1)
dot.Font = Enum.Font.Code
dot.TextSize = 16
dot.Text = "O"
dot.Parent = gui
dot.MouseButton1Click:Connect(function()
panel.Visible = not panel.Visible
end)
warn("[OMEGA MINI] v1.0 загружен — без скачиваний")