local function splice(s, old, new)
local a, b = s:find(old, 1, true)
if not a then return s, false end
return s:sub(1, a - 1) .. new .. s:sub(b + 1), true
end
local function dl(url, min)
local body = nil
local ok = pcall(function() body = game:HttpGet(url) end)
if not (ok and type(body) == "string" and #body > (min or 1000)) then
local mirror = url:gsub("^https://raw%.githubusercontent%.com/([^/]+)/([^/]+)/refs/heads/([^/]+)/(.+)$",
"https://cdn.jsdelivr.net/gh/%1/%2@%3/%4")
if mirror ~= url then
ok = pcall(function() body = game:HttpGet(mirror) end)
end
end
assert(ok and type(body) == "string" and #body > (min or 1000),
"[Omega Hub] Не скачался (и через зеркало тоже): " .. url)
return body
end
